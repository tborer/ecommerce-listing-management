# URL of the Python API Vercel project (the repo-root project), no trailing slash.
API_ORIGIN=https://your-api-project.vercel.app

# Public site URL used for canonical links, sitemap and social previews.
# Defaults to the Vercel production URL; set it once you add a custom domain.
SITE_URL=https://www.yourdomain.com
# SITE_NAME=SourceSnap
# GOOGLE_SITE_VERIFICATION=   # only for Search Console's "HTML tag" method

# Waitlist: "true" shows "Join the waitlist" buttons and a sign-up modal
# instead of "Get started". Sign-ups are emailed to you over SMTP.
ENABLE_WAITLIST=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (TLS from the start); false for 587 (STARTTLS)
SMTP_USER=you@example.com
SMTP_PASS=
SMTP_FROM=SourceSnap <you@example.com>
# WAITLIST_TO=you@example.com   # where sign-ups go; defaults to SMTP_USER

# Waitlist storage: connect the same Neon database to this project (sets DATABASE_URL).
DATABASE_URL=
# Shown on /privacy for privacy requests; LEGAL_ENTITY is the operator's legal name (optional).
CONTACT_EMAIL=privacy@yourdomain.com
# LEGAL_ENTITY=
